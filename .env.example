# IBM Quantum Platform API token - https://quantum.ibm.com/
# Only needed when running with --backend ibm
IBM_QUANTUM_TOKEN=

# Optional: pin a specific instance (channel/hub/group/project or CRN)
IBM_QUANTUM_INSTANCE=

# Optional: force a specific backend name (e.g. ibm_brisbane). Empty = least-busy.
IBM_QUANTUM_BACKEND=
